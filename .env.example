# Core service settings
APP_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=archai
POSTGRES_USER=archai
POSTGRES_PASSWORD=archai_password
POSTGRES_URL=postgresql://archai:archai_password@postgres:5432/archai

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=archai-graph

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# Worker settings
ARCHAI_WORKER_ID=worker-local
ARCHAI_WORKER_CAPABILITIES=recon,malware,sandbox,ai

# File systems
QUARANTINE_DIR=/app/quarantine
REPORTS_DIR=/app/reports

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
